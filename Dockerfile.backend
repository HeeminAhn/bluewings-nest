# Stage 1: Build
FROM gradle:8-jdk21 AS builder

WORKDIR /app

# Copy gradle files first for caching
COPY build.gradle.kts settings.gradle.kts gradle.properties ./
COPY gradle ./gradle

# Download dependencies
RUN gradle dependencies --no-daemon || true

# Cache buster for source changes
ARG CACHEBUST=1

# Copy source code
COPY src ./src

# Build the application (--no-build-cache to ensure fresh build)
RUN gradle build -Dquarkus.package.jar.type=uber-jar -x test --no-daemon --no-build-cache

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.20

WORKDIR /app

# Copy the built jar
COPY --from=builder /app/build/*-runner.jar /app/application.jar

# Copy JWT keys
COPY src/main/resources/publicKey.pem src/main/resources/privateKey.pem ./

# Create uploads directory
RUN mkdir -p /app/uploads

# Expose port
EXPOSE 8080

# Environment variables (can be overridden in docker-compose)
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

# Run the application with JAVA_OPTS
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/application.jar"]
